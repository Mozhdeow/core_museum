{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "noEmit": true, "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.edge.tsbuildinfo"
  },
  "include": ["supabase/functions/**/*.ts"]
}
